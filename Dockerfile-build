FROM nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04

ARG DEFORUM_BRANCH=main

WORKDIR /workdir

# Install system dependencies first
RUN apt-get update && \
    apt-get install -y --no-install-recommends git python3-pip && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Now we can use git to clone the repository
RUN git clone --depth 1 --branch "${DEFORUM_BRANCH}" \
    https://www.github.com/e-dream-ai/deforum-studio deforum

WORKDIR /workdir/deforum

RUN pip install --no-cache-dir -e . && \
    pip install --no-cache-dir runpod boto3 requests && \
    pip uninstall -y opencv-python opencv-python-headless && \
    pip install --no-cache-dir --force-reinstall opencv-python-headless && \
    rm -rf /root/.cache/pip

# Clone ComfyUI
RUN git clone --filter=blob:none --no-checkout \
      https://github.com/comfyanonymous/ComfyUI.git /workdir/deforum/src/ComfyUI && \
    git -C /workdir/deforum/src/ComfyUI checkout \
      daa92a8ff4d3e75a3b17bb1a6b6c508b27264ff5 && \
    rm -rf /workdir/deforum/src/ComfyUI/.git

WORKDIR /workdir/deforum

ENV COMFYUI_PATH=/workdir/deforum/src/ComfyUI
ENV COMFYUI_MODEL_PATH=/workdir/deforum/src/ComfyUI/models
ENV LORA_PATH=/deforum_storage/models/loras

# ——————————————————————————————————————————
# Conditionally install Protovision model (if you include ./models locally)
# ——————————————————————————————————————————
COPY ./models /tmp/models
RUN if [ -f /tmp/models/protovisionXLHighFidelity3D_releaseV660Bakedvae.safetensors ]; then \
      mkdir -p /deforum_storage/models && \
      cp /tmp/models/protovisionXLHighFidelity3D_releaseV660Bakedvae.safetensors \
         /deforum_storage/models/protovisionXLHighFidelity3D_releaseV660Bakedvae.safetensors; \
    fi
RUN rm -rf /tmp/models

COPY ./loras/manifest.json /tmp/loras/manifest.json
COPY ./scripts/download_loras.py /tmp/loras/download_loras.py
RUN python3 /tmp/loras/download_loras.py \
      --manifest /tmp/loras/manifest.json \
      --output /deforum_storage/models/loras && \
    rm -rf /tmp/loras

# ——————————————————————————————————————————
# Copy Serverless handler + predictor code
# ——————————————————————————————————————————
COPY ./src/ /workdir/deforum/src/

# Copy and install entrypoint
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# Entrypoint + default CMD
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["deforum", "runsingle", "--file", "/input/$SETTINGS_FILE"]
